# Backend Configuration
DATABASE_URL=sqlite:///./hybrid_ai.db

# Reasoning Model (Small Model)
REASONING_MODEL=Qwen/Qwen2.5-1.5B-Instruct
REASONING_MAX_TOKENS=300
REASONING_TEMPERATURE=0.7

# Chat Model (Large Model via Ollama)
CHAT_MODEL=mistral
OLLAMA_BASE=http://127.0.0.1:11434
CHAT_MAX_TOKENS=500
CHAT_TEMPERATURE=0.7

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Device (cuda or cpu)
DEVICE=cuda

# Debug
DEBUG=false